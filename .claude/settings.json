{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(unity *)",
      "Bash(python tools/*)",
      "Bash(pwsh -File tools/*)",
      "Bash(pwsh tools/*)",
      "Bash(powershell -ExecutionPolicy Bypass -File tools/*)",
      "PowerShell(git *)",
      "PowerShell(gh *)",
      "PowerShell(unity *)",
      "PowerShell(python tools/*)",
      "PowerShell(./tools/*)",
      "PowerShell(pwsh -File tools/*)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File tools/*)"
    ],
    "deny": [
      "Edit(/Library/**)",
      "Edit(/Temp/**)",
      "Edit(/Logs/**)",
      "Edit(/UserSettings/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git reset --hard*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/tools/hooks/guard.py\"", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/tools/hooks/stop_check.py\"", "timeout": 10 }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "unity-agent-plugin": {
      "source": { "source": "github", "repo": "Unity-Technologies/unity-agent-plugin" }
    }
  },
  "enabledPlugins": {
    "unity@unity-agent-plugin": true
  }
}
